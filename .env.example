# Copier vers .env puis générer un mot de passe local (voir README).
POSTGRES_USER=electionhub
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_DB=electionhub
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
API_PORT=8000
APP_ENV=local
# API métier désactivée par défaut. Activation explicite : voir docs/api/phase-2.md.
DEV_API_ENABLED=false
# DEV_API_KEY=<clé locale aléatoire d'au moins 32 caractères>
# DEV_ACTOR_ID=30000000-0000-4000-8000-000000000001
