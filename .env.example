# Copier vers .env puis générer un mot de passe local (voir README).
POSTGRES_USER=electionhub
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_DB=electionhub
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Local : disable. RDS/cloud : verify-full + chemin vers le bundle CA AWS monté.
POSTGRES_SSLMODE=disable
# POSTGRES_SSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_POOL_RECYCLE_SECONDS=300
API_PORT=8000
WEB_PORT=3000
APP_ENV=local
SESSION_TTL_SECONDS=3600
# Simulation locale sans envoi réseau. Activation : scripts/configure_otp.py --enable
CITIZEN_OTP_ENABLED=false
# OTP_HMAC_KEY=<secret aléatoire généré par le script, jamais commité>
# Stockage documentaire local par défaut. Pour S3 : s3 + région + bucket privé.
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_DIRECTORY=.local/objects
OBJECT_UPLOAD_MAX_BYTES=10485760
AWS_REGION=eu-north-1
# S3_BUCKET=electionhub-private-example
# Les identifiants AWS sont fournis par un rôle IAM ou le mécanisme standard du SDK,
# jamais dans ce fichier versionné.
