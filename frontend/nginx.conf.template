# Rendu au démarrage par l'entrypoint Nginx (envsubst). Seules les variables API_* sont
# substituées (NGINX_ENVSUBST_FILTER) ; les variables Nginx ($host, $uri...) restent intactes.
#   API_UPSTREAM     URL du backend FastAPI, sans chemin final (ex. http://api:8000 ou https://api.exemple.org)
#   API_HOST_HEADER  valeur de l'en-tête Host transmise au backend ($host en local)
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host ${API_HOST_HEADER};
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        # Utilisé seulement si l'amont est en HTTPS : SNI + vérification du certificat.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        error_page 502 503 504 = @api_unavailable;
    }
    location @api_unavailable {
        default_type application/json;
        return 503 '{"detail":"API indisponible."}';
    }
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { try_files $uri $uri/ /index.html; }
}
