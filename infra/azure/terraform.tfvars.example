api_upstream           = "https://api.example.org"
api_host_header        = "api.example.org"
# acr_resource_id      = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.ContainerRegistry/registries/<name>"
enable_new_resources   = false
